@model List<Beyti.Models.ChefProfile>
@{
    ViewData["Title"] = "Customer Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer-dashboard.css" asp-append-version="true" />
}

<div class="main-content">
    <div class="container py-5">
        <h2 class="customer-dashboard-title animate-fade-in">Customer Dashboard</h2>
        <div class="row">
            @foreach (var chefProfile in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="chef-card animate-fade-in">
                        <div class="card-body">
                            <h5>@chefProfile.User.Name</h5>
                            <p>Order delicious homemade food</p>
                            <a asp-controller="CustomerOrders"
                               asp-action="ChefMenu"
                               asp-route-chefId="@chefProfile.UserId"
                               class="btn btn-primary">
                                View Menu / Order
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>