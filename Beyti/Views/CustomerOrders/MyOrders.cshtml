@model List<Beyti.ViewModel.Customer.CustomerOrderVM>

<h2>My Orders</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no orders yet.</div>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>Order #@order.Id - @order.ChefName</span>
                <span class="badge bg-secondary">@order.Status</span>
            </div>
            <div class="card-body">
                <p>Total: @order.TotalPrice EGP</p>
                <p>Order Time: @order.OrderTime.ToLocalTime().ToString("dd MMM yyyy - HH:mm")</p>
                <table class="table table-sm mt-2">
                    <thead>
                        <tr>
                            <th>Recipe</th>
                            <th>Qty</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Details)
                        {
                            <tr>
                                <td>@item.RecipeTitle</td>
                                <td>@item.Quantity</td>
                                <td>@item.Price EGP</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (order.Status == Beyti.Models.OrderStatus.Pending)
            {
                <div class="card-footer text-end">
                    <form asp-action="Cancel" method="post">
                        <input type="hidden" name="id" value="@order.Id" />
                        <button class="btn btn-danger btn-sm">Cancel Order</button>
                    </form>
                </div>
            }
        </div>
    }
}
