@model List<Beyti.ViewModel.Customer.CustomerRecipeVM>
@{
    ViewData["Title"] = "Chef Menu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chef-menu.css" asp-append-version="true" />
}

<div class="main-content">
    <div class="container py-5">
        <h2 class="chef-menu-title animate-fade-in">@ViewBag.ChefName's Menu</h2>

        <form asp-action="PlaceOrder" method="post" class="menu-form">
            <input type="hidden" name="ChefId" value="@ViewBag.ChefId" />
            <div class="row">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="col-md-4 col-lg-4 mb-4">
                        <div class="recipe-card animate-fade-in">
                            @if (!string.IsNullOrEmpty(Model[i].ImagePath))
                            {
                                <img src="@Model[i].ImagePath" class="card-img-top" alt="@Model[i].Title" />
                            }
                            <div class="card-body">
                                <h5>@Model[i].Title</h5>
                                <p>@Model[i].Description</p>
                                <p class="price">@Model[i].Price EGP</p>
                                <input type="number"
                                       name="Items[@i].Quantity"
                                       min="0"
                                       value="0"
                                       class="form-control"
                                       placeholder="Quantity" />
                                <input type="hidden" name="Items[@i].RecipeId" value="@Model[i].Id" />
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button type="submit" class="order-submit-btn">Place Order</button>
        </form>
    </div>
</div>