@model List<Beyti.Models.User>
@{
    ViewData["Title"] = "Available Chefs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/available-chefs.css" asp-append-version="true" />
}

<div class="main-content">
    <div class="container py-5">
        <h2 class="available-chefs-title animate-fade-in">Available Chefs</h2>
        <div class="row">
            @foreach (var chef in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="chef-profile-card animate-fade-in">
                        <h5>@chef.Name</h5>
                        <a asp-controller="CustomerOrders"
                           asp-action="ChefMenu"
                           asp-route-chefId="@chef.Id"
                           class="btn btn-primary">
                            View Menu
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>