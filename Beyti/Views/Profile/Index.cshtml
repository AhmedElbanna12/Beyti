@using Beyti.ViewModel.Profile
@model ProfileVM
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <h2 class="mb-4">Hello, @Model.Name!</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card p-4">
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.PhoneNumber</p>
        <p><strong>Role:</strong> @Model.Role</p>
        <p><strong>Address:</strong> @Model.City, @Model.Street, Building: @Model.BuildingNo, Floor: @Model.Floor</p>

        <a asp-action="Edit" class="btn btn-beyti-primary mt-3">Edit Profile</a>
    </div>
</div>
