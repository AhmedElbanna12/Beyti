@model List<Beyti.Models.Order>
@{
    ViewData["Title"] = "Available Orders";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/delivery-orders.css" asp-append-version="true" />
}

<div class="container mt-4">
    <div class="delivery-orders-header">
        <h2>📦 Available Orders for Delivery</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="no-orders-delivery">
            <i class="bi bi-inbox"></i>
            <h3>No Orders Waiting</h3>
            <p>Check back later for new delivery orders</p>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="delivery-order-card">
                <div class="delivery-order-header">
                    <span class="delivery-order-title">🧾 Order #@order.Id</span>
                    <span style="opacity: 0.9;">Customer: @order.Customer.Name</span>
                </div>

                <div class="delivery-order-body">
                    <!-- Price and Chef Info -->
                    <div class="delivery-info-section">
                        <div class="delivery-info-grid">
                            <div class="delivery-info-item">
                                <strong>💰 Total Price</strong>
                                <span style="font-size: 1.3rem; font-weight: 800; color: #F3831C;">@order.TotalPrice EGP</span>
                            </div>
                            <div class="delivery-info-item">
                                <strong>👨‍🍳 Chef</strong>
                                <span style="font-weight: 600;">@order.Chef.Name</span>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Info -->
                    <div class="delivery-info-section">
                        <div class="delivery-info-title">
                            👤 Customer Information
                        </div>
                        <div class="delivery-info-grid">
                            <div class="delivery-info-item">
                                <strong>📞 Phone</strong>
                                @order.Customer.PhoneNumber
                            </div>
                            <div class="delivery-info-item">
                                <strong>📍 Address</strong>
                                @order.Customer.Address.Street, @order.Customer.Address.City
                            </div>
                        </div>
                    </div>

                    <!-- Order Details -->
                    <div class="delivery-info-section">
                        <div class="delivery-info-title">
                            🍽️ Order Items
                        </div>
                        <div class="delivery-order-items">
                            <ul>
                                @foreach (var item in order.OrderDetails)
                                {
                                    <li>@item.Recipe.Title - Quantity: @item.Quantity</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="delivery-order-footer">
                    <form asp-action="Accept" method="post">
                        <input type="hidden" name="id" value="@order.Id" />
                        <button type="submit" class="btn-delivery-action btn-delivery-accept">
                            ✓ Accept for Delivery
                        </button>
                    </form>
                </div>
            </div>
        }
    }
</div>