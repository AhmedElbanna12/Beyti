@model Beyti.ViewModel.Supplier.SupplierDashboardViewModel
@{
    ViewData["Title"] = "Supplier Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-dashboard.css" asp-append-version="true" />
}

<div class="main-content">
    <div class="container py-5">
        <h2 class="supplier-dashboard-title animate-fade-in">@Model.Supplier.CompanyName - Supplies</h2>

        <a asp-action="CreateSupply" class="add-supply-btn">
            <i class="fas fa-plus-circle me-2"></i>Add New Supply
        </a>

        @if (!Model.Supplier.Supplies.Any())
        {
            <div class="no-supplies-message animate-fade-in">
                No supplies added yet.
            </div>
        }
        else
        {
            <div class="row mb-5">
                @foreach (var supply in Model.Supplier.Supplies)
                {
                    <div class="col-md-4 mb-4">
                        <div class="supply-card animate-fade-in">
                            <div class="card-body">
                                <h5>@supply.Name</h5>
                                <p><strong>Category:</strong> @supply.Category</p>
                                <p><strong>Quality:</strong> @supply.QualityLevel</p>
                                <div class="card-actions">
                                    <a asp-action="EditSupply"
                                       asp-route-id="@supply.Id"
                                       class="btn-edit">
                                        Edit
                                    </a>
                                    <form asp-action="DeleteSupply"
                                          asp-route-id="@supply.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this supply?');"
                                          style="margin: 0;">
                                        <button class="btn-delete">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <h3 class="supplier-dashboard-subtitle">Available Chefs</h3>

        @if (!Model.AvailableChefs.Any())
        {
            <div class="no-chefs-message animate-fade-in">
                No chefs available currently.
            </div>
        }
        else
        {
            <table class="chefs-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var chef in Model.AvailableChefs)
                    {
                        <tr>
                            <td>@chef.User.Name</td>
                            <td>
                                <form asp-action="AssignChef" method="post" style="margin: 0;">
                                    <input type="hidden" name="chefId" value="@chef.Id" />
                                    <button type="submit" class="assign-chef-btn">Assign</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>