@model IEnumerable<Beyti.Models.ChefProfile>
@{
    ViewData["Title"] = "Available Chefs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/available-chefs-supplier.css" asp-append-version="true" />
}

<div class="main-content">
    <div class="container py-5">
        <h2 class="available-chefs-supplier-title animate-fade-in">Available Chefs</h2>

        <table class="chefs-supplier-table animate-fade-in">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var chef in Model)
                {
                    <tr>
                        <td>@chef.User.Name</td>
                        <td>@chef.User.Address</td>
                        <td>@chef.User.PhoneNumber</td>
                    </tr>
                }
            </tbody>
        </table>

        <a asp-action="Dashboard" class="back-to-dashboard-btn">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>