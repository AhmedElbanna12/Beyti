@model Beyti.ViewModel.chief.ChefDashboardVM
@{
    ViewData["Title"] = "Chef Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Welcome, @Model.ChefName</h2>

    <!-- Profile Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">Profile Info</div>
        <div class="card-body">
            <p><strong>Working Hours:</strong> @Model.WorkingHours</p>
            <p><strong>Delivery Fee per Km:</strong> $@Model.DeliveryFeePerKm</p>
        </div>
    </div>

    <!-- Recipes Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <span>My Recipes</span>
            <a asp-controller="ChefDashboard" asp-action="Create" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Add New Recipe
            </a>
        </div>
        <div class="card-body">
            @if (Model.Recipes?.Any() == true)
            {
                <div class="row">
                    @foreach (var recipe in Model.Recipes)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 shadow-sm">
                                <img src="@recipe.ImagePath" class="card-img-top" alt="@recipe.Title" style="height: 180px; object-fit: cover;">
                                <div class="card-body d-flex flex-column">
                                    <h5>@recipe.Title</h5>
                                    <p class="mb-1"><strong>Category:</strong> @recipe.Category</p>
                                    <p class="mb-1"><strong>Price:</strong> $@recipe.Price</p>
                                    <div class="mt-auto d-flex justify-content-between">
                                        <a asp-controller="ChefDashboard" asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <form asp-controller="ChefDashboard" asp-action="Delete" asp-route-id="@recipe.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No recipes added yet. Click "Add New Recipe" to start.</p>
            }
        </div>
    </div>


    <!-- Orders Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-warning text-dark">Orders</div>
        <div class="card-body">
            @if (Model.Orders?.Any() == true)
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th>Order Time</th>
                            <th>Delivery Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.CustomerName</td>
                                <td>$@order.TotalPrice</td>
                                <td>@order.Status</td>
                                <td>@order.OrderTime.ToString("g")</td>
                                <td>@(order.DeliveryTime.HasValue? order.DeliveryTime.Value.ToString("g") : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No orders yet.</p>
            }
        </div>
    </div>

    <!-- Supplies Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white">My Supplies</div>
        <div class="card-body">
            @if (Model.Supplies?.Any() == true)
            {
                <div class="row">
                    @foreach (var supply in Model.Supplies)
                    {
                        <div class="col-md-3 mb-3">
                            <div class="card h-100 shadow-sm">
                                <img src="@supply.Image" class="card-img-top" alt="@supply.SupplierName" style="height: 150px; object-fit: cover;">
                                <div class="card-body">
                                    <h5>@supply.SupplierName</h5>
                                    <p class="mb-1"><strong>Category:</strong> @supply.Category</p>
                                    <p class="mb-1"><strong>Quality:</strong> @supply.QualityLevel</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>No supplies linked yet.</p>
            }
        </div>
    </div>

    <!-- Wallet Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">Wallet</div>
        <div class="card-body">
            <p><strong>Balance:</strong> $@Model.WalletBalance</p>
            @if (Model.Transactions?.Any() == true)
            {
                <table class="table table-sm table-bordered mt-3">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Direction</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in Model.Transactions)
                        {
                            <tr>
                                <td>@txn.CreatedAt.ToString("g")</td>
                                <td>$@txn.Amount</td>
                                <td>@txn.Direction</td>
                                <td>@txn.Type</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
