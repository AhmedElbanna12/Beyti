@model Beyti.ViewModel.chief.ChefDashboardVM
@{
    ViewData["Title"] = "Chef Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chef-dashboard.css" asp-append-version="true" />
}

<div class="container mt-4">
    <!-- Dashboard Header -->
    <div class="dashboard-header text-center">
        <h2>Welcome, @Model.ChefName! 👨‍🍳</h2>
        <p style="font-size: 1.1rem; opacity: 0.9; margin-top: 10px;">Manage your recipes, orders, and more</p>
    </div>

    <!-- Profile Section -->
    <div class="dashboard-card">
        <div class="dashboard-card-header profile">
            <span>👤 Profile Information</span>
        </div>
        <div class="dashboard-card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong style="color: #3A4624;">⏰ Working Hours:</strong> @Model.WorkingHours hours/day</p>
                </div>
                <div class="col-md-6">
                    <p><strong style="color: #3A4624;">🚚 Delivery Fee per Km:</strong> $@Model.DeliveryFeePerKm</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recipes Section -->
    <div class="dashboard-card">
        <div class="dashboard-card-header recipes">
            <span>🍳 My Recipes</span>
            <a asp-controller="ChefDashboard" asp-action="Create" class="btn-add-recipe">
                + Add New Recipe
            </a>
        </div>
        <div class="dashboard-card-body">
            @if (Model.Recipes?.Any() == true)
            {
                <div class="row g-4">
                    @foreach (var recipe in Model.Recipes)
                    {
                        <div class="col-md-4">
                            <div class="recipe-card">
                                <img src="@recipe.ImagePath" alt="@recipe.Title">
                                <div class="recipe-card-body">
                                    <h5>@recipe.Title</h5>
                                    <p><strong>Category:</strong> @recipe.Category</p>
                                    <p><strong>Price:</strong> $@recipe.Price</p>
                                    <div class="d-flex justify-content-between mt-3">
                                        <a asp-controller="ChefDashboard" asp-action="Edit" asp-route-id="@recipe.Id" class="btn-beyti-edit">
                                            ✏️ Edit
                                        </a>
                                        <form asp-controller="ChefDashboard" asp-action="Delete" asp-route-id="@recipe.Id" method="post" onsubmit="return confirm('Delete this recipe?');" class="d-inline">
                                            <button type="submit" class="btn-beyti-delete">
                                                🗑️ Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-egg-fried"></i>
                    <p>No recipes yet. Start creating delicious dishes!</p>
                </div>
            }
        </div>
    </div>

    <!-- Orders Section -->
    <div class="dashboard-card">
        <div class="dashboard-card-header orders">
            <span>📋 Orders</span>
        </div>
        <div class="dashboard-card-body">
            @if (Model.Orders?.Any() == true)
            {
                @foreach (var order in Model.Orders)
                {
                    <div class="order-card">
                        <div class="order-card-header">
                            <span style="font-weight: 700; color: #3A4624;">Order #@order.Id - @order.CustomerName</span>
                            <span class="order-badge @order.Status.ToString().ToLower()">@order.Status</span>
                        </div>
                        <div class="dashboard-card-body">
                            <p><strong style="color: #F3831C;">Total:</strong> $@order.TotalPrice</p>
                            <p><strong style="color: #3A4624;">Order Time:</strong> @order.OrderTime.ToLocalTime().ToString("dd MMM yyyy - HH:mm")</p>
                            <table class="table table-sm mt-3">
                                <thead style="background: #fafaf8;">
                                    <tr>
                                        <th>Recipe</th>
                                        <th>Qty</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.Details)
                                    {
                                        <tr>
                                            <td>@item.RecipeTitle</td>
                                            <td>@item.Quantity</td>
                                            <td>$@item.Price</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (order.Status == Beyti.Models.OrderStatus.Pending)
                        {
                            <div style="padding: 15px 25px; text-align: right; background: #fafaf8; border-top: 2px solid #e0dcc8;">
                                <form asp-controller="ChefOrders" asp-action="Accept" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="btn-beyti-accept">✓ Accept</button>
                                </form>
                                <form asp-controller="ChefOrders" asp-action="Reject" method="post" class="d-inline ms-2">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="btn-beyti-reject">✗ Reject</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-cart-x"></i>
                    <p>No orders yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- Suppliers Section -->
    <div class="dashboard-card">
        <div class="dashboard-card-header suppliers">
            <span>📦 My Suppliers</span>
        </div>
        <div class="dashboard-card-body">
            @if (Model.Supplies?.Any() == true)
            {
                <div class="row g-4">
                    @foreach (var supply in Model.Supplies)
                    {
                        <div class="col-md-4">
                            <div class="supplier-card">
                                <img src="@supply.Image" alt="@supply.SupplierName">
                                <div class="supplier-card-body">
                                    <h5>@supply.SupplierName</h5>
                                    <p><strong>Category:</strong> @supply.Category</p>
                                    <p><strong>Quality:</strong> @supply.QualityLevel</p>
                                    <hr style="border-color: #e0dcc8;" />
                                    <p style="color: #666;"><i class="bi bi-geo-alt" style="color: #F3831C;"></i> @supply.Address</p>
                                    <p style="color: #666;"><i class="bi bi-telephone" style="color: #F3831C;"></i> @supply.PhoneNumber</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-box-seam"></i>
                    <p>No suppliers linked yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- Wallet Section -->
    <div class="dashboard-card">
        <div class="dashboard-card-header wallet">
            <span>💰 Wallet</span>
        </div>
        <div class="dashboard-card-body">
            <div class="wallet-balance">
                $@Model.WalletBalance
            </div>
            @if (Model.Transactions?.Any() == true)
            {
                <table class="transaction-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Direction</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in Model.Transactions)
                        {
                            <tr>
                                <td>@txn.CreatedAt.ToString("g")</td>
                                <td style="font-weight: 700; color: #F3831C;">$@txn.Amount</td>
                                <td>@txn.Direction</td>
                                <td>@txn.Type</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-wallet2"></i>
                    <p>No transactions yet.</p>
                </div>
            }
        </div>
    </div>
</div>