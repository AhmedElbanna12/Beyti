@model Beyti.ViewModel.chief.RecipeVM
@{
    ViewData["Title"] = "Edit Recipe";
}

<h2>Edit Recipe</h2>

<form asp-action="Edit"   method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredients" class="form-label"></label>
        <textarea asp-for="Ingredients" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="PreparationTime" class="form-label"></label>
        <input asp-for="PreparationTime" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label>Current Image</label><br />
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" style="width:200px; height:150px; object-fit:cover;" />
        }
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Change Image</label>
        <input asp-for="ImageFile" class="form-control" type="file" />
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-pencil-square"></i> Save Changes
    </button>
</form>
