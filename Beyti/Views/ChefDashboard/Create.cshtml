@model Beyti.ViewModel.chief.RecipeVM
@{
    ViewData["Title"] = "Add New Recipe";
}

@section Styles {
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chef-recipe-form.css" asp-append-version="true" />
}

<div class="recipe-form-container">
    <div class="recipe-form-header">
        <h2>Add New Recipe 🍳</h2>
    </div>

    <div class="recipe-form-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="recipe-form-group">
                <label asp-for="Title" class="recipe-form-label">Recipe Title</label>
                <input asp-for="Title" class="recipe-form-control" placeholder="e.g., Chicken Shawarma" />
                <span asp-validation-for="Title" class="form-validation-error"></span>
            </div>

            <div class="form-row-split">
                <div class="recipe-form-group">
                    <label asp-for="Category" class="recipe-form-label">Category</label>
                    <input asp-for="Category" class="recipe-form-control" placeholder="e.g., Main Course" />
                    <span asp-validation-for="Category" class="form-validation-error"></span>
                </div>

                <div class="recipe-form-group">
                    <label asp-for="Price" class="recipe-form-label">Price ($)</label>
                    <input asp-for="Price" class="recipe-form-control" type="number" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Price" class="form-validation-error"></span>
                </div>
            </div>

            <div class="recipe-form-group">
                <label asp-for="Description" class="recipe-form-label">Description</label>
                <textarea asp-for="Description" class="recipe-form-control" placeholder="Describe your delicious recipe..."></textarea>
                <span asp-validation-for="Description" class="form-validation-error"></span>
            </div>

            <div class="recipe-form-group">
                <label asp-for="Ingredients" class="recipe-form-label">Ingredients</label>
                <textarea asp-for="Ingredients" class="recipe-form-control" placeholder="List all ingredients (one per line)"></textarea>
                <span asp-validation-for="Ingredients" class="form-validation-error"></span>
                <span class="form-helper-text">Separate each ingredient with a new line</span>
            </div>

            <div class="recipe-form-group">
                <label asp-for="PreparationTime" class="recipe-form-label">Preparation Time (minutes)</label>
                <input asp-for="PreparationTime" class="recipe-form-control" type="number" placeholder="30" />
                <span asp-validation-for="PreparationTime" class="form-validation-error"></span>
            </div>

            <div class="recipe-form-group">
                <label class="recipe-form-label">Recipe Image</label>
                <div class="file-input-wrapper">
                    <input asp-for="ImageFile" type="file" id="imageFile" accept="image/*" />
                    <label for="imageFile" class="file-input-label">
                        <i class="bi bi-cloud-upload"></i>
                        <span>Click to upload image</span>
                    </label>
                </div>
                <span asp-validation-for="ImageFile" class="form-validation-error"></span>
            </div>

            <button type="submit" class="btn-submit-recipe">
                <i class="bi bi-plus-circle"></i>
                Add Recipe
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}