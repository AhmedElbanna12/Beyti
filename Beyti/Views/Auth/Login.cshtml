@model Beyti.ViewModel.LoginVM
@{
    ViewData["Title"] = "Login - Beyti";
}

    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />


<div class="login-container-beyti">
    <div class="container">
        <div class="login-card-beyti">
            <div class="row g-0">
                <div class="col-lg-5">
                    <div class="login-left-beyti">
                        <div class="login-left-content">
                            <h2>Welcome Back! 👋</h2>
                            <p>Sign in to continue your Beyti journey and enjoy delicious homemade meals</p>
                            <ul class="login-feature-list">
                                <li>Access your personalized dashboard</li>
                                <li>Manage your orders and deliveries</li>
                                <li>Connect with the community</li>
                                <li>Track your earnings and wallet</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="login-right-beyti">
                        <h3>Sign In</h3>
                        <p class="login-subtitle-beyti">Enter your credentials to access your account</p>

                        <form asp-action="Login" method="post">
                            <div class="login-form-group">
                                <label asp-for="Email" class="login-form-label">Email Address</label>
                                <input asp-for="Email" class="login-form-control" placeholder="your@email.com" />
                                <span asp-validation-for="Email" class="validation-error"></span>
                            </div>

                            <div class="login-form-group">
                                <label asp-for="Password" class="login-form-label">Password</label>
                                <input asp-for="Password" type="password" class="login-form-control" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="validation-error"></span>
                            </div>

                            <div class="remember-me-container">
                                <input asp-for="RememberMe" type="checkbox" class="remember-me-checkbox" id="rememberMe" />
                                <label asp-for="RememberMe" class="remember-me-label" for="rememberMe">
                                    Remember me
                                </label>
                            </div>

                            <button type="submit" class="btn-login-beyti">Sign In</button>

                            <div class="register-link-beyti">
                                Don't have an account? <a asp-action="Register" asp-controller="Auth">Create one now</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}